          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_companies",
        "title": "List companies",
        "description": "List companies in a workspace.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "Workspace/account id to filter by."
            },
            "search": {
              "type": "string",
              "description": "Optional case-insensitive name filter."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Max rows (default 100)."
            }
          },
          "required": [
            "workspaceId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_contacts",
        "title": "List contacts",
        "description": "List contacts in a workspace, optionally filtered by company or search term.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspaceId": {
              "type": "string"
            },
            "companyId": {
              "type": "string"
            },
            "search": {
              "type": "string",
              "description": "Match on name or email (ilike)."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "workspaceId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_deals",
        "title": "List pipeline deals",
        "description": "List deals in a workspace, optionally filtered by stage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspaceId": {
              "type": "string"
            },
            "stage": {
              "type": "string",
              "description": "Optional pipeline stage filter."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "workspaceId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_events",
        "title": "List events",
        "description": "List events in a workspace.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspaceId": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "cancelled"
              ]
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "workspaceId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List tasks for an event.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "done"
              ]
            }
          },
          "required": [
            "eventId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a new task on an event.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "done"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "dueDate": {
              "type": "string",
              "description": "ISO date yyyy-mm-dd"
            }
          },
          "required": [
            "eventId",
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_touchpoint",
        "title": "Add pipeline touchpoint",
        "description": "Log a touchpoint (activity note) on a deal.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "dealId": {
              "type": "string"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "description": "Free-form kind label, e.g. call, email, meeting."
            }
          },
          "required": [
            "dealId",
            "note"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
